@model HSLR.Models.Entities.CollaborationInquiry
@{
    ViewData["Title"] = $"Inquiry #{Model.Id} — {Model.FullName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small font-monospace mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Inquiries</a></li>
                <li class="breadcrumb-item active" aria-current="page">#HSRL-@Model.Id.ToString("D5")</li>
            </ol>
        </nav>
        <h2 class="h3 fw-bold text-navy mb-0">Inquiry Details</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Pipeline
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Submitter & Inquiry Info -->
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
                <div>
                    <h4 class="fw-bold text-navy mb-1">@Model.FullName</h4>
                    <div class="text-secondary small">
                        <i class="bi bi-building me-1"></i> @Model.Organization &bull;
                        <span class="badge bg-light text-dark border">@Model.AffiliationType</span>
                    </div>
                </div>
                <div class="text-end font-monospace">
                    <span class="badge bg-primary fs-6">@Model.Status</span>
                    <div class="small text-muted mt-1">@Model.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                </div>
            </div>

            <!-- Subject / Proposal -->
            @if (!string.IsNullOrWhiteSpace(Model.Title))
            {
                <div class="mb-3">
                    <span class="small text-muted font-monospace text-uppercase d-block">Proposal Subject</span>
                    <h5 class="fw-bold text-navy">@Model.Title</h5>
                </div>
            }

            <div class="mb-4">
                <span class="small text-muted font-monospace text-uppercase d-block mb-1">Inquiry Description</span>
                <div class="p-4 bg-light rounded-3 border text-secondary" style="white-space: pre-wrap; line-height: 1.8;">
                    @Model.Description
                </div>
            </div>

            <div class="row g-3 small border-top pt-3">
                <div class="col-sm-6">
                    <span class="text-muted font-monospace d-block">Direct Email:</span>
                    <a href="mailto:@Model.Email" class="fw-bold text-primary">@Model.Email</a>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted font-monospace d-block">Collaboration Category:</span>
                    <span class="fw-bold text-navy">@Model.CollaborationType</span>
                </div>
                @if (Model.ResearchDomain != null)
                {
                    <div class="col-12">
                        <span class="text-muted font-monospace d-block">Associated Research Domain:</span>
                        <span class="fw-bold text-navy">@Model.ResearchDomain.Title</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Admin Actions & Notes -->
    <div class="col-lg-4">
        <!-- Status Update Form -->
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
            <h5 class="fw-bold text-navy mb-3 border-bottom pb-2">
                <i class="bi bi-sliders me-1 text-primary"></i> Manage Status
            </h5>

            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label small font-monospace fw-bold">Update Inquiry Status</label>
                    <select name="status" class="form-select small">
                        @foreach (var s in Enum.GetValues<HSLR.Models.Entities.InquiryStatus>())
                        {
                            <option value="@((int)s)" selected="@(Model.Status == s ? "selected" : null)">@s</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small font-monospace fw-bold">Internal Faculty / Admin Notes</label>
                    <textarea name="adminNotes" rows="4" class="form-control small" placeholder="e.g. Discussed with Prof. Waseem; awaiting formal proposal...">@Model.AdminNotes</textarea>
                </div>

                <button type="submit" class="btn btn-hsrl-primary w-100 btn-sm">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>
            </form>
        </div>

        <!-- Quick Reply / Actions -->
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
            <h6 class="fw-bold text-navy mb-3 font-monospace text-uppercase small">Actions</h6>
            <div class="vstack gap-2">
                <a href="mailto:@Model.Email?subject=Re: HSRL Collaboration Inquiry #HSRL-@Model.Id.ToString("D5")" class="btn btn-sm btn-outline-primary text-start">
                    <i class="bi bi-reply-fill me-2"></i> Reply via Email Client
                </a>

                <form asp-action="ToggleSpam" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm @(Model.IsSpam ? "btn-outline-success" : "btn-outline-warning") text-start w-100">
                        <i class="bi @(Model.IsSpam ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                        @(Model.IsSpam ? "Unmark as Spam" : "Mark as Spam")
                    </button>
                </form>

                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this inquiry?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger text-start w-100">
                        <i class="bi bi-trash-fill me-2"></i> Delete Inquiry
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
