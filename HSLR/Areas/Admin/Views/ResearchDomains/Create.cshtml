@model HSLR.Models.Entities.ResearchDomain
@{
    ViewData["Title"] = "Add Research Domain";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small font-monospace mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Research Domains</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
        <h2 class="h3 fw-bold text-navy mb-0">Add Research Domain</h2>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label small fw-bold font-monospace">Domain Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Slug" class="form-label small fw-bold font-monospace">Slug</label>
                <input asp-for="Slug" class="form-control" placeholder="auto-generated if blank" />
                <span asp-validation-for="Slug" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="IconName" class="form-label small fw-bold font-monospace">Bootstrap Icon Class</label>
                <input asp-for="IconName" class="form-control" placeholder="bi-water" />
                <span asp-validation-for="IconName" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="DisplayOrder" class="form-label small fw-bold font-monospace">Display Order</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="ShortDescription" class="form-label small fw-bold font-monospace">Short Description</label>
                <textarea asp-for="ShortDescription" rows="2" class="form-control"></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label small fw-bold font-monospace">Full Detailed Description</label>
                <textarea asp-for="Description" rows="5" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Focus Topics (One per line)</label>
                <textarea name="focusTopicsList" rows="4" class="form-control" placeholder="Focus Topic 1&#10;Focus Topic 2"></textarea>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-3">
                    <input asp-for="Featured" class="form-check-input" />
                    <label asp-for="Featured" class="form-check-label small text-secondary">Feature on Home Page</label>
                </div>
            </div>

            <div class="col-12 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-hsrl-primary">Create Domain</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>
