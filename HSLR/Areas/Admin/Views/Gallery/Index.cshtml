@model List<HSLR.Models.Entities.GalleryItem>
@{
    ViewData["Title"] = "Gallery Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-navy mb-1">Photo Gallery & Fieldwork Media</h2>
        <p class="text-secondary small mb-0">Upload and manage photographic documentation from research expeditions and workshops.</p>
    </div>
    <a asp-action="Create" class="btn btn-sm btn-hsrl-primary">
        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Photo
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light font-monospace text-muted">
                <tr>
                    <th class="ps-4">Preview & Title</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Date</th>
                    <th>Order</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-2 bg-dark d-flex align-items-center justify-content-center text-white" style="width: 48px; height: 48px; font-size: 1.2rem;">
                                    <i class="bi bi-image"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-navy">@g.Title</div>
                                    <small class="text-muted font-monospace">@g.ImageUrl</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border font-monospace">@g.Category</span></td>
                        <td><small class="text-secondary"><i class="bi bi-geo-alt me-1 text-danger"></i>@(g.Location ?? "—")</small></td>
                        <td class="font-monospace">@(g.EventDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="font-monospace">@g.DisplayOrder</td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this photo item?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
