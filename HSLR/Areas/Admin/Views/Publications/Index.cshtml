@model List<HSLR.Models.Entities.Publication>
@{
    ViewData["Title"] = "Publications Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-navy mb-1">Peer-Reviewed Publications</h2>
        <p class="text-secondary small mb-0">Manage scientific journals, conference proceedings, and technical reports.</p>
    </div>
    <a asp-action="Create" class="btn btn-sm btn-hsrl-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Publication
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light font-monospace text-muted">
                <tr>
                    <th class="ps-4">Title & Venue</th>
                    <th>Authors</th>
                    <th>Year</th>
                    <th>Type</th>
                    <th>Featured</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pub in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-navy">@pub.Title</div>
                            <small class="text-primary font-monospace">@(pub.Journal ?? "Report / Preprint")</small>
                            @if (!string.IsNullOrWhiteSpace(pub.Doi))
                            {
                                <small class="text-muted font-monospace ms-2">DOI: @pub.Doi</small>
                            }
                        </td>
                        <td>
                            <small class="text-secondary">@string.Join(", ", pub.Authors.Select(a => a.AuthorName))</small>
                        </td>
                        <td class="font-monospace fw-bold">@pub.Year</td>
                        <td>
                            <span class="badge bg-light text-dark border font-monospace">@pub.PublicationType</span>
                        </td>
                        <td>
                            @if (pub.Featured)
                            {
                                <span class="badge bg-warning text-dark">Featured</span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@pub.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this publication?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pub.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
