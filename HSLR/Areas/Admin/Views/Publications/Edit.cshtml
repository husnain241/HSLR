@model HSLR.Models.Entities.Publication
@{
    ViewData["Title"] = "Edit Publication";
    var authorsList = ViewBag.AuthorsList as string ?? "";
    var selectedDomainIds = ViewBag.SelectedDomainIds as List<int> ?? new();
    var domains = ViewBag.Domains as List<HSLR.Models.Entities.ResearchDomain> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small font-monospace mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Publications</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
        <h2 class="h3 fw-bold text-navy mb-0">Edit Publication</h2>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
    <!-- ⚠️ CRITICAL FIX: enctype="multipart/form-data" added for file uploads -->
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

        <div class="row g-3">
            <!-- Basic Info -->
            <div class="col-12">
                <label asp-for="Title" class="form-label small fw-bold font-monospace">Paper Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Journal" class="form-label small fw-bold font-monospace">Journal / Conference Name</label>
                <input asp-for="Journal" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="Year" class="form-label small fw-bold font-monospace">Year</label>
                <input asp-for="Year" type="number" class="form-control" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="PublicationType" class="form-label small fw-bold font-monospace">Type</label>
                <select asp-for="PublicationType" class="form-select" asp-items="Html.GetEnumSelectList<HSLR.Models.Entities.PublicationType>()"></select>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Authors (Comma-separated)</label>
                <input type="text" name="authorsList" value="@authorsList" class="form-control" placeholder="e.g., Dr. Ahmed, Ali Khan, Dr. Smith" />
            </div>

            <div class="col-md-6">
                <label asp-for="Doi" class="form-label small fw-bold font-monospace">DOI</label>
                <input asp-for="Doi" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="Url" class="form-label small fw-bold font-monospace">Direct URL</label>
                <input asp-for="Url" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="Abstract" class="form-label small fw-bold font-monospace">Abstract</label>
                <textarea asp-for="Abstract" rows="4" class="form-control"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="CitationMetrics" class="form-label small fw-bold font-monospace">Citation Metrics</label>
                <input asp-for="CitationMetrics" class="form-control" />
            </div>

            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input asp-for="Featured" class="form-check-input" />
                    <label asp-for="Featured" class="form-check-label small text-secondary">Feature on Home Page</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Associated Research Domains</label>
                <div class="row g-2">
                    @foreach (var d in domains)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="domainIds" value="@d.Id" id="domain_@d.Id"
                                @(selectedDomainIds.Contains(d.Id) ? "checked" : "")>
                                <label class="form-check-label small" for="domain_@d.Id">
                                    @d.Title
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Images Section -->
            <div class="col-12">
                <hr class="my-4" />
                <h6 class="fw-bold text-navy mb-3"><i class="bi bi-images me-2"></i>Publication Images</h6>
            </div>

            <!-- Image 1 -->
            <div class="col-md-6">
                <label class="form-label small fw-bold font-monospace">Image 1 (Primary)</label>
                @if (!string.IsNullOrEmpty(Model.Image1Url))
                {
                    <div class="mb-2 p-2 bg-light rounded border">
                        <img src="@Model.Image1Url" alt="Current Image 1" class="img-fluid rounded" style="max-height: 120px; object-fit: cover;" />
                        <input type="hidden" asp-for="Image1Url" /> <!-- CRITICAL: Keeps old URL if no new file is uploaded -->
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-success"><i class="bi bi-check-circle"></i> Saved</small>
                        </div>
                    </div>
                }
                <input type="file" class="form-control form-control-sm" name="imageFile1" accept="image/*" />
                <small class="text-muted" style="font-size: 0.75rem;">Leave empty to keep current.</small>
            </div>

            <!-- Image 2 -->
            <div class="col-md-6">
                <label class="form-label small fw-bold font-monospace">Image 2</label>
                @if (!string.IsNullOrEmpty(Model.Image2Url))
                {
                    <div class="mb-2 p-2 bg-light rounded border">
                        <img src="@Model.Image2Url" alt="Current Image 2" class="img-fluid rounded" style="max-height: 120px; object-fit: cover;" />
                        <input type="hidden" asp-for="Image2Url" />
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-success"><i class="bi bi-check-circle"></i> Saved</small>
                        </div>
                    </div>
                }
                <input type="file" class="form-control form-control-sm" name="imageFile2" accept="image/*" />
                <small class="text-muted" style="font-size: 0.75rem;">Leave empty to keep current.</small>
            </div>

            <!-- Image 3 -->
            <div class="col-md-6">
                <label class="form-label small fw-bold font-monospace">Image 3</label>
                @if (!string.IsNullOrEmpty(Model.Image3Url))
                {
                    <div class="mb-2 p-2 bg-light rounded border">
                        <img src="@Model.Image3Url" alt="Current Image 3" class="img-fluid rounded" style="max-height: 120px; object-fit: cover;" />
                        <input type="hidden" asp-for="Image3Url" />
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-success"><i class="bi bi-check-circle"></i> Saved</small>
                        </div>
                    </div>
                }
                <input type="file" class="form-control form-control-sm" name="imageFile3" accept="image/*" />
                <small class="text-muted" style="font-size: 0.75rem;">Leave empty to keep current.</small>
            </div>

            <!-- Image 4 -->
            <div class="col-md-6">
                <label class="form-label small fw-bold font-monospace">Image 4</label>
                @if (!string.IsNullOrEmpty(Model.Image4Url))
                {
                    <div class="mb-2 p-2 bg-light rounded border">
                        <img src="@Model.Image4Url" alt="Current Image 4" class="img-fluid rounded" style="max-height: 120px; object-fit: cover;" />
                        <input type="hidden" asp-for="Image4Url" />
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-success"><i class="bi bi-check-circle"></i> Saved</small>
                        </div>
                    </div>
                }
                <input type="file" class="form-control form-control-sm" name="imageFile4" accept="image/*" />
                <small class="text-muted" style="font-size: 0.75rem;">Leave empty to keep current.</small>
            </div>

            <!-- Action Buttons -->
            <div class="col-12 pt-3 border-top d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-hsrl-primary">
                    <i class="bi bi-check-lg me-1"></i> Update Publication
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i> Cancel
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}