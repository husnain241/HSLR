@model HSLR.Models.Entities.Publication
@{
    ViewData["Title"] = "Add Publication";
    var domains = ViewBag.Domains as List<HSLR.Models.Entities.ResearchDomain> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small font-monospace mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Publications</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
        <h2 class="h3 fw-bold text-navy mb-0">Add Publication Record</h2>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label small fw-bold font-monospace">Paper Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Journal" class="form-label small fw-bold font-monospace">Journal / Conference Name</label>
                <input asp-for="Journal" class="form-control" placeholder="e.g. Journal of Hydrology" />
            </div>

            <div class="col-md-3">
                <label asp-for="Year" class="form-label small fw-bold font-monospace">Year</label>
                <input asp-for="Year" type="number" class="form-control" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="PublicationType" class="form-label small fw-bold font-monospace">Type</label>
                <select asp-for="PublicationType" class="form-select" asp-items="Html.GetEnumSelectList<HSLR.Models.Entities.PublicationType>()"></select>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Authors (Comma-separated)</label>
                <input type="text" name="authorsList" class="form-control" placeholder="Boota, M. W., Tahir, U. A., Zahra, F." />
            </div>

            <div class="col-md-6">
                <label asp-for="Doi" class="form-label small fw-bold font-monospace">DOI</label>
                <input asp-for="Doi" class="form-control" placeholder="10.1016/j.jhydrol..." />
            </div>

            <div class="col-md-6">
                <label asp-for="Url" class="form-label small fw-bold font-monospace">Direct URL</label>
                <input asp-for="Url" class="form-control" placeholder="https://doi.org/..." />
            </div>

            <div class="col-12">
                <label asp-for="Abstract" class="form-label small fw-bold font-monospace">Abstract</label>
                <textarea asp-for="Abstract" rows="4" class="form-control"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="CitationMetrics" class="form-label small fw-bold font-monospace">Citation Metrics / Impact Factor</label>
                <input asp-for="CitationMetrics" class="form-control" placeholder="Impact Factor: 6.4" />
            </div>

            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input asp-for="Featured" class="form-check-input" />
                    <label asp-for="Featured" class="form-check-label small text-secondary">Feature on Home Page</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Associated Research Domains</label>
                <div class="row g-2">
                    @foreach (var d in domains)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="domainIds" value="@d.Id" id="domain_@d.Id">
                                <label class="form-check-label small" for="domain_@d.Id">
                                    @d.Title
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-hsrl-primary">Save Publication</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>
