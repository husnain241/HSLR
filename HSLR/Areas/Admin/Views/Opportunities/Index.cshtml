@model List<HSLR.Models.Entities.OfficialOpportunity>
@{
    ViewData["Title"] = "Opportunities Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-navy mb-1">Open Positions & Opportunities</h2>
        <p class="text-secondary small mb-0">Manage open PhD fellowships, MS assistantships, and research associate recruitment calls.</p>
    </div>
    <a asp-action="Create" class="btn btn-sm btn-hsrl-primary">
        <i class="bi bi-plus-lg me-1"></i> Post Opportunity
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light font-monospace text-muted">
                <tr>
                    <th class="ps-4">Title</th>
                    <th>Category</th>
                    <th>Deadline</th>
                    <th>Status</th>
                    <th>Order</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var opp in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-navy">@opp.Title</div>
                            <small class="text-muted">@(opp.Description.Length > 80 ? opp.Description.Substring(0, 80) + "..." : opp.Description)</small>
                        </td>
                        <td><span class="badge bg-light text-dark border font-monospace">@opp.Category</span></td>
                        <td class="font-monospace">@(opp.Deadline?.ToString("yyyy-MM-dd") ?? "Open until filled")</td>
                        <td>
                            <span class="badge @(opp.Status == HSLR.Models.Entities.OpportunityStatus.Open ? "bg-success" : "bg-secondary") font-monospace">
                                @opp.Status
                            </span>
                        </td>
                        <td class="font-monospace">@opp.DisplayOrder</td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@opp.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this opportunity?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@opp.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
