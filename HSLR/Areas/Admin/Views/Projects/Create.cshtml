@model HSLR.Models.Entities.Project
@{
    ViewData["Title"] = "Add Project";
    var domains = ViewBag.Domains as List<HSLR.Models.Entities.ResearchDomain> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small font-monospace mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Projects</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
        <h2 class="h3 fw-bold text-navy mb-0">Add Research Project</h2>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label small fw-bold font-monospace">Full Project Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ShortTitle" class="form-label small fw-bold font-monospace">Short Title</label>
                <input asp-for="ShortTitle" class="form-control" />
                <span asp-validation-for="ShortTitle" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Slug" class="form-label small fw-bold font-monospace">Slug</label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Subtitle" class="form-label small fw-bold font-monospace">Subtitle (Optional summary)</label>
                <input asp-for="Subtitle" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Status" class="form-label small fw-bold font-monospace">Status</label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<HSLR.Models.Entities.ProjectStatus>()"></select>
            </div>

            <div class="col-md-4">
                <label asp-for="ProjectType" class="form-label small fw-bold font-monospace">Project Type</label>
                <select asp-for="ProjectType" class="form-select" asp-items="Html.GetEnumSelectList<HSLR.Models.Entities.ProjectType>()"></select>
            </div>

            <div class="col-md-4">
                <label asp-for="Year" class="form-label small fw-bold font-monospace">Initiation Year</label>
                <input asp-for="Year" type="number" class="form-control" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="StudyArea" class="form-label small fw-bold font-monospace">Study Area</label>
                <input asp-for="StudyArea" class="form-control" placeholder="e.g. Upper Indus Basin / Rechna Doab" />
                <span asp-validation-for="StudyArea" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Country" class="form-label small fw-bold font-monospace">Country</label>
                <input asp-for="Country" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="Challenge" class="form-label small fw-bold font-monospace">The Research Challenge (Problem Statement)</label>
                <textarea asp-for="Challenge" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Challenge" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Impact" class="form-label small fw-bold font-monospace">Societal & Policy Impact</label>
                <textarea asp-for="Impact" rows="3" class="form-control"></textarea>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Project Objectives (One per line)</label>
                <textarea name="objectivesList" rows="3" class="form-control" placeholder="Objective 1&#10;Objective 2"></textarea>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Data Sources (Comma-separated)</label>
                <input type="text" name="dataSourcesList" class="form-control" placeholder="Sentinel-1 SAR, SWOT, GPM IMERG, ERA5" />
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Technologies (Comma-separated)</label>
                <input type="text" name="technologiesList" class="form-control" placeholder="Google Earth Engine, Python, HEC-RAS 2D, PyTorch" />
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Key Findings (One per line)</label>
                <textarea name="findingsList" rows="3" class="form-control" placeholder="Finding 1&#10;Finding 2"></textarea>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-3">
                    <input asp-for="Featured" class="form-check-input" />
                    <label asp-for="Featured" class="form-check-label small text-secondary">Feature on Home Page</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label small fw-bold font-monospace">Associated Research Domains</label>
                <div class="row g-2">
                    @foreach (var d in domains)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="domainIds" value="@d.Id" id="proj_domain_@d.Id">
                                <label class="form-check-label small" for="proj_domain_@d.Id">
                                    @d.Title
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-hsrl-primary">Save Project</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>
