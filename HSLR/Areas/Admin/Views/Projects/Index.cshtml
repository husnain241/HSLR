@model List<HSLR.Models.Entities.Project>
@{
    ViewData["Title"] = "Projects Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-navy mb-1">Research Projects & Grants</h2>
        <p class="text-secondary small mb-0">Manage research case studies, study areas, workflows, and datasets.</p>
    </div>
    <a asp-action="Create" class="btn btn-sm btn-hsrl-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Project
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light font-monospace text-muted">
                <tr>
                    <th class="ps-4">Title & Slug</th>
                    <th>Study Area</th>
                    <th>Year</th>
                    <th>Status</th>
                    <th>Type</th>
                    <th>Featured</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proj in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-navy">@proj.Title</div>
                            <small class="text-muted font-monospace">@proj.Slug</small>
                        </td>
                        <td>
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> @proj.StudyArea
                        </td>
                        <td class="font-monospace">@proj.Year</td>
                        <td>
                            <span class="badge @(proj.Status == HSLR.Models.Entities.ProjectStatus.Active ? "bg-success-subtle text-success" : "bg-light text-dark border") font-monospace">
                                @proj.Status
                            </span>
                        </td>
                        <td><span class="badge bg-light text-secondary border font-monospace">@proj.ProjectType</span></td>
                        <td>
                            @if (proj.Featured)
                            {
                                <span class="badge bg-warning text-dark">Yes</span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-area="" asp-controller="Projects" asp-action="Details" asp-route-slug="@proj.Slug" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@proj.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this project?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@proj.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
