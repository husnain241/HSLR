@model List<HSLR.Models.Entities.Person>
@{
    ViewData["Title"] = "Team Members Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-navy mb-1">Research Family & Faculty</h2>
        <p class="text-secondary small mb-0">Manage profiles for the Lab Director, faculty, research fellows, scholars, and collaborators.</p>
    </div>
    <a asp-action="Create" class="btn btn-sm btn-hsrl-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Team Member
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light font-monospace text-muted">
                <tr>
                    <th class="ps-4">Member</th>
                    <th>Role & Category</th>
                    <th>Status</th>
                    <th>Featured</th>
                    <th>Order</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="hsrl-avatar flex-shrink-0" style="width: 36px; height: 36px; font-size: 0.9rem;">
                                    @p.Initials
                                </div>
                                <div>
                                    <div class="fw-bold text-navy">@p.Name</div>
                                    <small class="text-muted font-monospace">@p.Slug</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@p.Role</div>
                            <span class="badge bg-light text-secondary border font-monospace">@p.Category</span>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success font-monospace">@p.Status</span>
                        </td>
                        <td>
                            @if (p.Featured)
                            {
                                <span class="badge bg-warning text-dark">Yes</span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>
                        <td class="font-monospace">@p.DisplayOrder</td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this profile?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
