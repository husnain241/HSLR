@model List<HSLR.Models.Entities.Event>
@{
    ViewData["Title"] = "Events Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-navy mb-1">Seminars, Workshops & Fieldwork</h2>
        <p class="text-secondary small mb-0">Manage upcoming and past research gatherings, conferences, and fieldwork schedules.</p>
    </div>
    <a asp-action="Create" class="btn btn-sm btn-hsrl-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Event
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light font-monospace text-muted">
                <tr>
                    <th class="ps-4">Title & Slug</th>
                    <th>Date & Time</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Featured</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-navy">@ev.Title</div>
                            <small class="text-muted font-monospace">@ev.Slug</small>
                        </td>
                        <td class="font-monospace">
                            <div>@ev.EventDate.ToString("yyyy-MM-dd")</div>
                            <small class="text-muted">@ev.EventDate.ToString("HH:mm") UTC</small>
                        </td>
                        <td><span class="badge bg-light text-dark border font-monospace">@ev.EventType</span></td>
                        <td><small class="text-secondary"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@ev.Location</small></td>
                        <td>
                            <span class="badge @(ev.Status == HSLR.Models.Entities.EventStatus.Upcoming ? "bg-success" : "bg-secondary") font-monospace">
                                @ev.Status
                            </span>
                        </td>
                        <td>
                            @if (ev.Featured)
                            {
                                <span class="badge bg-warning text-dark">Yes</span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@ev.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
