
@model HSLR.Models.ViewModels.HomeIndexViewModel
<!-- Hero Section -->
<section class="hsrl-hero">
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hsrl-hero-tag">
                    <i class="bi bi-geo-alt-fill text-danger"></i>
                    <span>CEWRE &bull; University of Engineering & Technology Lahore</span>
                </div>
                <h1 class="hsrl-hero-title">
                    Hydroclimatic Sensing<br />
                    <span style="color: var(--hsrl-hydro-light);">Research Laboratory</span>
                </h1>
                <p class="hsrl-hero-desc">
                    Advancing satellite remote sensing, numerical hydrology, and physics-informed artificial intelligence to address real-world flood extremes, groundwater depletion, and climate resilience across the Indus Basin and regional mountain cryosphere.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Research" asp-action="Index" class="btn btn-hsrl-hydro btn-lg">
                        <i class="bi bi-compass me-2"></i> Explore Research
                    </a>
                    <a asp-controller="Collaboration" asp-action="Index" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-send me-2"></i> Submit Collaboration Inquiry
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block">
                <div class="card bg-dark bg-opacity-50 text-white border-0 p-4 rounded-4 shadow-lg backdrop-blur" style="border: 1px solid rgba(255,255,255,0.15) !important;">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="hsrl-brand-icon">
                            <i class="bi bi-satellite"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Active Spaceborne Missions</h6>
                            <small class="text-light">Copernicus, NASA, JAXA</small>
                        </div>
                    </div>
                    <p class="small text-white-50 mb-3">
                        Operational assimilation of Sentinel-1/2, SWOT radar altimetry, GPM IMERG, SMAP, and GRACE/GRACE-FO mascons into catchment-scale hydrological models.
                    </p>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-50">
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Online</span>
                        <span class="small font-monospace text-light">Indus Basin Grid</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
<!-- Featured Publications Carousel Section -->
@if (Model.FeaturedPublications != null && Model.FeaturedPublications.Any())
{
    var chunks = Model.FeaturedPublications
        .Select((x, i) => new { Index = i, Value = x })
        .GroupBy(x => x.Index / 3)
        .Select(g => g.Select(x => x.Value).ToList())
        .ToList();

    <section class="py-5 bg-light">
        <div class="container py-4">
            <div class="section-header text-center mb-5">
                <span class="section-eyebrow"><i class="bi bi-journal-richtext"></i> Latest Research</span>
                <h2 class="section-title">Featured Publications</h2>
                <p class="section-lead">Explore our latest peer-reviewed research and scientific contributions.</p>
            </div>

            @if (chunks.Count == 1)
            {
                <div class="row g-4">
                    @foreach (var pub in chunks[0])
                    {
                        var domainName = "Interdisciplinary Research";
                        if (pub.PublicationResearchAreas != null && pub.PublicationResearchAreas.Any())
                        {
                            var firstArea = pub.PublicationResearchAreas.FirstOrDefault();
                            if (firstArea?.ResearchDomain != null)
                            {
                                domainName = firstArea.ResearchDomain.Title;
                            }
                        }

                        var shortAbstract = "No abstract available.";
                        if (!string.IsNullOrEmpty(pub.Abstract))
                        {
                            shortAbstract = pub.Abstract.Length > 120
                                ? pub.Abstract.Substring(0, 120) + "..."
                                : pub.Abstract;
                        }

                        var images = new List<string>();
                        if (!string.IsNullOrEmpty(pub.Image1Url)) images.Add(pub.Image1Url);
                        if (!string.IsNullOrEmpty(pub.Image2Url)) images.Add(pub.Image2Url);
                        if (!string.IsNullOrEmpty(pub.Image3Url)) images.Add(pub.Image3Url);
                        if (!string.IsNullOrEmpty(pub.Image4Url)) images.Add(pub.Image4Url);

                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm transition-all"
                                 style="cursor: pointer; transition: transform 0.3s ease, box-shadow 0.3s ease;"
                                 onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.1)';"
                                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';"
                                 data-bs-toggle="modal" data-bs-target="#pubModal-@pub.Id">

                                <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-start">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                        <i class="bi bi-tag-fill me-1"></i> @domainName
                                    </span>
                                    <span class="badge bg-dark text-white font-monospace">@pub.Year</span>
                                </div>

                                <div class="card-body">
                                    <h5 class="card-title fw-bold text-navy mb-3" style="line-height: 1.4;">@pub.Title</h5>
                                    <p class="card-text text-muted small">@shortAbstract</p>
                                </div>

                                <div class="card-footer bg-white border-top-0 pb-3 px-3">
                                    @if (images.Count > 0)
                                    {
                                        <div id="miniCarousel-@pub.Id" class="carousel slide" data-bs-ride="carousel" data-bs-interval="1500">
                                            <div class="carousel-inner rounded-3 overflow-hidden border" style="height: 180px; background: #f8f9fa;">
                                                @for (int imgIdx = 0; imgIdx < images.Count; imgIdx++)
                                                {
                                                    <div class="carousel-item @(imgIdx == 0 ? "active" : "")">
                                                        <img src="@images[imgIdx]" class="d-block w-100" style="height: 180px; object-fit: cover;" alt="Publication Image">
                                                    </div>
                                                }
                                            </div>

                                            @if (images.Count > 1)
                                            {
                                                <button class="carousel-control-prev" type="button" data-bs-target="#miniCarousel-@pub.Id" data-bs-slide="prev" onclick="event.stopPropagation();">
                                                    <span class="carousel-control-prev-icon bg-dark bg-opacity-50 rounded-circle p-2" aria-hidden="true"></span>
                                                </button>
                                                <button class="carousel-control-next" type="button" data-bs-target="#miniCarousel-@pub.Id" data-bs-slide="next" onclick="event.stopPropagation();">
                                                    <span class="carousel-control-next-icon bg-dark bg-opacity-50 rounded-circle p-2" aria-hidden="true"></span>
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center text-muted py-4" style="background: #f8f9fa; border-radius: 0.5rem;">
                                            <i class="bi bi-image fs-1"></i>
                                            <p class="mt-2 mb-0 small">No images uploaded yet</p>
                                        </div>
                                    }
                                    <div class="text-center mt-2">
                                        <small class="text-primary fw-semibold"><i class="bi bi-eye me-1"></i> Click to view details</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div id="pubsMainCarousel" class="carousel slide" data-bs-ride="false">
                    <div class="carousel-inner">
                        @for (int i = 0; i < chunks.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <div class="row g-4">
                                    @foreach (var pub in chunks[i])
                                    {
                                        var domainName = "Interdisciplinary Research";
                                        if (pub.PublicationResearchAreas != null && pub.PublicationResearchAreas.Any())
                                        {
                                            var firstArea = pub.PublicationResearchAreas.FirstOrDefault();
                                            if (firstArea?.ResearchDomain != null)
                                            {
                                                domainName = firstArea.ResearchDomain.Title;
                                            }
                                        }

                                        var shortAbstract = "No abstract available.";
                                        if (!string.IsNullOrEmpty(pub.Abstract))
                                        {
                                            shortAbstract = pub.Abstract.Length > 120
                                                ? pub.Abstract.Substring(0, 120) + "..."
                                                : pub.Abstract;
                                        }

                                        var images = new List<string>();
                                        if (!string.IsNullOrEmpty(pub.Image1Url)) images.Add(pub.Image1Url);
                                        if (!string.IsNullOrEmpty(pub.Image2Url)) images.Add(pub.Image2Url);
                                        if (!string.IsNullOrEmpty(pub.Image3Url)) images.Add(pub.Image3Url);
                                        if (!string.IsNullOrEmpty(pub.Image4Url)) images.Add(pub.Image4Url);

                                        <div class="col-md-4">
                                            <div class="card h-100 border-0 shadow-sm transition-all"
                                                 style="cursor: pointer; transition: transform 0.3s ease, box-shadow 0.3s ease;"
                                                 onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.1)';"
                                                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';"
                                                 data-bs-toggle="modal" data-bs-target="#pubModal-@pub.Id">

                                                <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-start">
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                                        <i class="bi bi-tag-fill me-1"></i> @domainName
                                                    </span>
                                                    <span class="badge bg-dark text-white font-monospace">@pub.Year</span>
                                                </div>

                                                <div class="card-body">
                                                    <h5 class="card-title fw-bold text-navy mb-3" style="line-height: 1.4;">@pub.Title</h5>
                                                    <p class="card-text text-muted small">@shortAbstract</p>
                                                </div>

                                                <div class="card-footer bg-white border-top-0 pb-3 px-3">
                                                    @if (images.Count > 0)
                                                    {
                                                        <div id="miniCarousel-@pub.Id" class="carousel slide" data-bs-ride="carousel" data-bs-interval="1500">
                                                            <div class="carousel-inner rounded-3 overflow-hidden border" style="height: 180px; background: #f8f9fa;">
                                                                @for (int imgIdx = 0; imgIdx < images.Count; imgIdx++)
                                                                {
                                                                    <div class="carousel-item @(imgIdx == 0 ? "active" : "")">
                                                                        <img src="@images[imgIdx]" class="d-block w-100" style="height: 180px; object-fit: cover;" alt="Publication Image">
                                                                    </div>
                                                                }
                                                            </div>

                                                            @if (images.Count > 1)
                                                            {
                                                                <button class="carousel-control-prev" type="button" data-bs-target="#miniCarousel-@pub.Id" data-bs-slide="prev" onclick="event.stopPropagation();">
                                                                    <span class="carousel-control-prev-icon bg-dark bg-opacity-50 rounded-circle p-2" aria-hidden="true"></span>
                                                                </button>
                                                                <button class="carousel-control-next" type="button" data-bs-target="#miniCarousel-@pub.Id" data-bs-slide="next" onclick="event.stopPropagation();">
                                                                    <span class="carousel-control-next-icon bg-dark bg-opacity-50 rounded-circle p-2" aria-hidden="true"></span>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center text-muted py-4" style="background: #f8f9fa; border-radius: 0.5rem;">
                                                            <i class="bi bi-image fs-1"></i>
                                                            <p class="mt-2 mb-0 small">No images uploaded yet</p>
                                                        </div>
                                                    }
                                                    <div class="text-center mt-2">
                                                        <small class="text-primary fw-semibold"><i class="bi bi-eye me-1"></i> Click to view details</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (chunks.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#pubsMainCarousel" data-bs-slide="prev" style="width: 5%; left: -3%;">
                            <span class="carousel-control-prev-icon bg-primary rounded-circle p-3 shadow-sm" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#pubsMainCarousel" data-bs-slide="next" style="width: 5%; right: -3%;">
                            <span class="carousel-control-next-icon bg-primary rounded-circle p-3 shadow-sm" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            }

            <div class="text-center mt-5">
                <a asp-controller="Publications" asp-action="Index" class="btn btn-hsrl-outline px-4">
                    View All Publications <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </section>
}
else
{
    <section class="py-5 bg-light">
        <div class="container py-4 text-center">
            <div class="alert alert-info d-inline-block shadow-sm">
                <i class="bi bi-info-circle me-2"></i>
                No featured publications available at this time.
            </div>
        </div>
    </section>
}
<!-- Research Metrics Section -->
<section class="py-5 bg-white border-bottom">
    <div class="container py-4">
        <div class="section-header text-center">
            <span class="section-eyebrow">
                <i class="bi bi-bar-chart-fill"></i> Research at a Glance
            </span>
            <h2 class="section-title">HSRL Research Impact</h2>
            <p class="section-lead">
                A snapshot of the laboratory's research output, funded projects,
                core research areas, and research community.
            </p>
        </div>

        <div class="row g-4 text-center">

            <!-- Peer-Reviewed Papers -->
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-light h-100 border">
                    <div class="hsrl-brand-icon mx-auto mb-3"
                         style="background: var(--hsrl-navy);">
                        <i class="bi bi-journal-text"></i>
                    </div>

                    <h2 class="fw-bold text-navy mb-1">
                        @Model.TotalPublications+
                    </h2>

                    <h5 class="fw-bold text-navy mb-2">
                        Peer-Reviewed Papers
                    </h5>

                    <p class="text-muted small mb-0">
                        Published peer-reviewed research contributing to
                        scientific knowledge and innovation.
                    </p>
                </div>
            </div>

            <!-- Funded & Applied Projects -->
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-light h-100 border">
                    <div class="hsrl-brand-icon mx-auto mb-3"
                         style="background: #0284c7;">
                        <i class="bi bi-kanban-fill"></i>
                    </div>

                    <h2 class="fw-bold text-navy mb-1">
                        @Model.TotalProjects
                    </h2>

                    <h5 class="fw-bold text-navy mb-2">
                        Funded & Applied Projects
                    </h5>

                    <p class="text-muted small mb-0">
                        Funded research initiatives focused on practical
                        scientific and environmental challenges.
                    </p>
                </div>
            </div>

            <!-- Core Research Pillars -->
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-light h-100 border">
                    <div class="hsrl-brand-icon mx-auto mb-3"
                         style="background: #0d9488;">
                        <i class="bi bi-diagram-3-fill"></i>
                    </div>

                    <h2 class="fw-bold text-navy mb-1">
                        @Model.TotalDomains
                    </h2>

                    <h5 class="fw-bold text-navy mb-2">
                        Core Research Pillars
                    </h5>

                    <p class="text-muted small mb-0">
                        Core research domains supporting the laboratory's
                        multidisciplinary scientific work.
                    </p>
                </div>
            </div>

            <!-- Faculty & Graduate Researchers -->
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-light h-100 border">
                    <div class="hsrl-brand-icon mx-auto mb-3"
                         style="background: #0f172a;">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h2 class="fw-bold text-navy mb-1">
                        @Model.TotalScholars+
                    </h2>

                    <h5 class="fw-bold text-navy mb-2">
                        Faculty & Graduate Researchers
                    </h5>

                    <p class="text-muted small mb-0">
                        Faculty members and graduate researchers contributing
                        to HSRL's research activities.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Core Research Domains Section -->
<section class="py-5" style="background-color: var(--hsrl-surface-bg);">
    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div class="section-header mb-md-0">
                <span class="section-eyebrow"><i class="bi bi-grid-fill"></i> Focus Areas</span>
                <h2 class="section-title">Core Research Domains</h2>
                <p class="section-lead mb-0">Targeted scientific investigations addressing the regional hydroclimate nexus.</p>
            </div>
            <div>
                <a asp-controller="Research" asp-action="Index" class="btn btn-hsrl-outline">
                    View All Domains <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var domain in Model.ResearchDomains)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="hsrl-card">
                        <div class="hsrl-card-body">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="hsrl-brand-icon" style="background: rgba(14, 165, 233, 0.1); color: var(--hsrl-hydro-dark);">
                                    <i class="bi @domain.IconName fs-4"></i>
                                </div>
                                <span class="badge bg-light text-muted border font-monospace">Domain 0@(domain.DisplayOrder)</span>
                            </div>
                            <h5 class="fw-bold mb-2 text-navy">@domain.Title</h5>
                        </div>
                        <div class="hsrl-card-footer d-flex justify-content-between align-items-center">
                            <a asp-controller="Research" asp-action="Index" class="text-decoration-none fw-semibold small text-primary">
                                Read Domain Details <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Geographic Scope Section -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-eyebrow"><i class="bi bi-compass-fill"></i> Territorial Coverage</span>
                <h2 class="section-title">Geographic & Environmental Scope</h2>
                <p class="section-lead">
                    HSRL's geographical domain spans the entire hydrological continuum of the Indus River Basin — from the high-altitude glacier-fed headwaters in the Karakoram to the deltaic coastal wetlands in the Arabian Sea.
                </p>
                <div class="vstack gap-3 mt-4">
                    <div class="d-flex gap-3">
                        <i class="bi bi-snow2 fs-3 text-info"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Upper Indus Basin & High Mountain Cryosphere</h6>
                            <p class="text-muted small mb-0">Gilgit-Baltistan, Hunza, and pass reaches — monitoring glacier mass anomalies, glacial lakes, and snowpack accumulation.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <i class="bi bi-water fs-3 text-primary"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Indus River Mainstem & Tributaries</h6>
                            <p class="text-muted small mb-0">Jhelum, Chenab, Ravi, and Sutlej floodplains — calibrating 2D hydrodynamic flood propagation and levee breach models.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <i class="bi bi-layers fs-3 text-success"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Indus Basin Irrigation System (IBIS)</h6>
                            <p class="text-muted small mb-0">Intensively farmed doabs across Punjab and Sindh — tracking multi-decadal aquifer depletion via GRACE gravimetry.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="p-4 rounded-4 text-white" style="background: linear-gradient(135deg, var(--hsrl-navy-dark), var(--hsrl-navy)); border: 1px solid rgba(14, 165, 233, 0.3);">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-info"></i> Regional Transboundary Basins
                    </h5>
                    <p class="small text-white-50 mb-4">
                        Because water flows without political boundaries, our satellite sensing algorithms ingest planetary datasets covering transboundary basins in South Asia and the Hindu Kush Himalaya (HKH) region.
                    </p>
                    <div class="row g-3 text-center">
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10">
                                <span class="font-monospace fs-4 fw-bold text-info">1.12M</span>
                                <div class="small text-white-50">km² Basin Extent</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10">
                                <span class="font-monospace fs-4 fw-bold text-info">>5,000</span>
                                <div class="small text-white-50">Glaciers Monitored</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lab Capabilities Section -->
<section class="py-5" style="background-color: var(--hsrl-surface-bg);">
    <div class="container py-4">
        <div class="section-header text-center">
            <span class="section-eyebrow"><i class="bi bi-tools"></i> Infrastructure & Tooling</span>
            <h2 class="section-title">Technical Capabilities</h2>
            <p class="section-lead">World-class computational and analytical infrastructure dedicated to hydroclimatic research.</p>
        </div>

        <div class="row g-4">
            @foreach (var cap in Model.Capabilities)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="hsrl-card">
                        <div class="hsrl-card-body">
                            <div class="hsrl-brand-icon mb-3" style="background: rgba(10, 37, 64, 0.08); color: var(--hsrl-navy);">
                                <i class="bi @cap.IconName fs-4"></i>
                            </div>
                            <span class="badge bg-secondary-subtle text-secondary small font-monospace mb-2">@cap.Category</span>
                            <h6 class="fw-bold text-navy mb-2">@cap.Title</h6>
                            <p class="text-muted small mb-3">@cap.Description</p>
                            
                            @if (cap.Highlights.Any())
                            {
                                <ul class="list-unstyled small text-muted mb-0 pt-2 border-top">
                                    @foreach (var item in cap.Highlights.Take(2))
                                    {
                                        <li class="mb-1 d-flex gap-2">
                                            <i class="bi bi-check2 text-success"></i>
                                            <span>@item.Highlight</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Final Collaboration CTA Banner -->
<section class="py-5 text-white" style="background: linear-gradient(135deg, var(--hsrl-navy-dark) 0%, var(--hsrl-navy) 100%);">
    <div class="container py-4 text-center">
        <div class="max-w-750 mx-auto">
            <span class="hsrl-hero-tag mb-3">
                <i class="bi bi-handshake text-info"></i> Partner With Us
            </span>
            <h2 class="display-5 fw-bold mb-3">Collaborate With HSRL</h2>
            <p class="lead text-white-50 mb-4">
                We invite academic researchers, government departments, international development agencies, and graduate applicants to partner with us on cutting-edge water and climate initiatives.
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-3">
                <a asp-controller="Collaboration" asp-action="Index" class="btn btn-hsrl-hydro btn-lg">
                    <i class="bi bi-pencil-square me-2"></i> Submit Collaboration Proposal
                </a>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-mortarboard me-2"></i> View Open Opportunities
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Publication Details Modals -->
@if (Model.FeaturedPublications != null)
{
    @foreach (var pub in Model.FeaturedPublications)
    {
        
            // Domain names collect karna
            var domainNamesList = new List<string>();
            if (pub.PublicationResearchAreas != null)
            {
                foreach (var pra in pub.PublicationResearchAreas)
                {
                    if (pra.ResearchDomain != null && !string.IsNullOrEmpty(pra.ResearchDomain.Title))
                    {
                        domainNamesList.Add(pra.ResearchDomain.Title);
                    }
                }
            }
            var domainNames = string.Join(", ", domainNamesList);
            if (string.IsNullOrEmpty(domainNames)) domainNames = "Interdisciplinary Research";

            // Author names collect karna (DisplayOrder ke hisaab se sort)
            var authorNamesList = new List<string>();
            if (pub.Authors != null)
            {
                var sortedAuthors = pub.Authors.OrderBy(a => a.DisplayOrder).ToList();
                foreach (var author in sortedAuthors)
                {
                    if (!string.IsNullOrEmpty(author.AuthorName))
                    {
                        authorNamesList.Add(author.AuthorName);
                    }
                }
            }
            var authorNames = string.Join(", ", authorNamesList);
            if (string.IsNullOrEmpty(authorNames)) authorNames = "Unknown Author";

            // Modal images collect karna
            var modalImages = new List<string>();
            if (!string.IsNullOrEmpty(pub.Image1Url)) modalImages.Add(pub.Image1Url);
            if (!string.IsNullOrEmpty(pub.Image2Url)) modalImages.Add(pub.Image2Url);
            if (!string.IsNullOrEmpty(pub.Image3Url)) modalImages.Add(pub.Image3Url);
            if (!string.IsNullOrEmpty(pub.Image4Url)) modalImages.Add(pub.Image4Url);
  

        <div class="modal fade" id="pubModal-@pub.Id" tabindex="-1" aria-labelledby="pubModalLabel-@pub.Id" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg">
                    <!-- Modal Header -->
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold" id="pubModalLabel-@pub.Id">
                            <i class="bi bi-journal-text me-2"></i> Publication Details
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body p-4">
                        <div class="row g-4">
                            <!-- Left Side: Publication Details -->
                            <div class="col-lg-7">
                                <span class="badge bg-primary bg-opacity-10 text-primary mb-2">@domainNames</span>
                                <h3 class="fw-bold text-navy mb-3">@pub.Title</h3>

                                <div class="d-flex flex-wrap gap-3 mb-3 text-muted small">
                                    <span><i class="bi bi-people me-1"></i> @authorNames</span>
                                    @if (!string.IsNullOrEmpty(pub.Journal))
                                    {
                                        <span><i class="bi bi-building me-1"></i> @pub.Journal</span>
                                    }
                                    <span><i class="bi bi-calendar3 me-1"></i> @pub.Year</span>
                                    @if (!string.IsNullOrEmpty(pub.CitationMetrics))
                                    {
                                        <span><i class="bi bi-graph-up me-1"></i> Citations: @pub.CitationMetrics</span>
                                    }
                                </div>

                                <hr class="my-3">

                                <h6 class="fw-bold text-navy mb-2">Abstract</h6>
                                <p class="text-muted" style="line-height: 1.8;">@(pub.Abstract ?? "No abstract available.")</p>

                                @if (!string.IsNullOrEmpty(pub.Url))
                                {
                                    <a href="@pub.Url" target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-3">
                                        <i class="bi bi-box-arrow-up-right me-2"></i> View Full Paper / DOI
                                    </a>
                                }
                            </div>

                            <!-- Right Side: 2x2 Image Grid -->
                            <div class="col-lg-5">
                                <h6 class="fw-bold text-navy mb-3">Research Visuals</h6>
                                @if (modalImages.Count > 0)
                                {
                                    <div class="row g-2">
                                        @for (int i = 0; i < Math.Min(4, modalImages.Count); i++)
                                        {
                                            <div class="col-6">
                                                <img src="@modalImages[i]" class="img-fluid rounded-3 border" style="height: 150px; width: 100%; object-fit: cover;" alt="Research Image @(i + 1)">
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center text-muted py-5 bg-light rounded-3">
                                        <i class="bi bi-image fs-1"></i>
                                        <p class="mt-2 mb-0">No images available for this publication.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
<!-- Optional: Image Zoom Modal (Agar kisi image par click karke bari karni ho) -->
<div class="modal fade" id="imageZoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center p-0">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img id="zoomedImage" src="" class="img-fluid rounded shadow-lg" alt="Zoomed Image">
            </div>
        </div>
    </div>
</div>
