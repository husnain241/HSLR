@model HSLR.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Hydroclimatic Sensing Research Lab";
    ViewData["MetaDescription"] = Model.Config.Description;
}

<!-- Hero Section -->
<section class="hsrl-hero">
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="hsrl-hero-tag">
                    <i class="bi bi-geo-alt-fill text-danger"></i>
                    <span>CEWRE &bull; University of Engineering & Technology Lahore</span>
                </div>
                <h1 class="hsrl-hero-title">
                    Hydroclimatic Sensing<br />
                    <span style="color: var(--hsrl-hydro-light);">Research Laboratory</span>
                </h1>
                <p class="hsrl-hero-desc">
                    Advancing satellite remote sensing, numerical hydrology, and physics-informed artificial intelligence to address real-world flood extremes, groundwater depletion, and climate resilience across the Indus Basin and regional mountain cryosphere.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Research" asp-action="Index" class="btn btn-hsrl-hydro btn-lg">
                        <i class="bi bi-compass me-2"></i> Explore Research
                    </a>
                    <a asp-controller="Collaboration" asp-action="Index" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-send me-2"></i> Submit Collaboration Inquiry
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block">
                <div class="card bg-dark bg-opacity-50 text-white border-0 p-4 rounded-4 shadow-lg backdrop-blur" style="border: 1px solid rgba(255,255,255,0.15) !important;">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="hsrl-brand-icon">
                            <i class="bi bi-satellite"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Active Spaceborne Missions</h6>
                            <small class="text-light">Copernicus, NASA, JAXA</small>
                        </div>
                    </div>
                    <p class="small text-white-50 mb-3">
                        Operational assimilation of Sentinel-1/2, SWOT radar altimetry, GPM IMERG, SMAP, and GRACE/GRACE-FO mascons into catchment-scale hydrological models.
                    </p>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-50">
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Online</span>
                        <span class="small font-monospace text-light">Indus Basin Grid</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Numbers -->
        <div class="hsrl-hero-stats">
            <div class="row g-4 text-center text-sm-start">
                <div class="col-6 col-md-3">
                    <div class="hero-stat-item">
                        <span class="hero-stat-num">@Model.TotalPublications+</span>
                        <span class="hero-stat-label">Peer-Reviewed Papers</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="hero-stat-item">
                        <span class="hero-stat-num">@Model.TotalProjects</span>
                        <span class="hero-stat-label">Funded & Applied Projects</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="hero-stat-item">
                        <span class="hero-stat-num">@Model.TotalDomains</span>
                        <span class="hero-stat-label">Core Research Pillars</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="hero-stat-item">
                        <span class="hero-stat-num">@Model.TotalScholars+</span>
                        <span class="hero-stat-label">Faculty & Graduate Researchers</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Scientific Pipeline / Approach Section -->
<section class="py-5 bg-white border-bottom">
    <div class="container py-4">
        <div class="section-header text-center">
            <span class="section-eyebrow"><i class="bi bi-diagram-3-fill"></i> Lab Methodology</span>
            <h2 class="section-title">The HSRL Scientific Pipeline</h2>
            <p class="section-lead">
                An integrated, data-driven framework connecting orbital space sensors to in-situ ground realities and actionable policy decision tools.
            </p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-light h-100 border">
                    <div class="hsrl-brand-icon mx-auto mb-3" style="background: var(--hsrl-navy);">
                        <i class="bi bi-broadcast-pin"></i>
                    </div>
                    <h5 class="fw-bold text-navy mb-2">1. Spaceborne Sensing</h5>
                    <p class="text-muted small mb-0">Multi-satellite radar altimetry, SAR backscatter, optical imagery, and gravity anomalies.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-light h-100 border">
                    <div class="hsrl-brand-icon mx-auto mb-3" style="background: #0284c7;">
                        <i class="bi bi-water"></i>
                    </div>
                    <h5 class="fw-bold text-navy mb-2">2. Numerical Hydraulics</h5>
                    <p class="text-muted small mb-0">High-resolution 2D unsteady hydrodynamic modeling (HEC-RAS) and catchment water balance.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-light h-100 border">
                    <div class="hsrl-brand-icon mx-auto mb-3" style="background: #0d9488;">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <h5 class="fw-bold text-navy mb-2">3. Physics-Informed AI</h5>
                    <p class="text-muted small mb-0">Recurrent neural networks, transformers, and PINNs obeying conservation laws for forecasting.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4 rounded-4 bg-light h-100 border">
                    <div class="hsrl-brand-icon mx-auto mb-3" style="background: #0f172a;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="fw-bold text-navy mb-2">4. Decision Support</h5>
                    <p class="text-muted small mb-0">Operational hazard bulletins, early warnings, and aquifer management guidelines for agencies.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Research Domains Section -->
<section class="py-5" style="background-color: var(--hsrl-surface-bg);">
    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div class="section-header mb-md-0">
                <span class="section-eyebrow"><i class="bi bi-grid-fill"></i> Focus Areas</span>
                <h2 class="section-title">Core Research Domains</h2>
                <p class="section-lead mb-0">Targeted scientific investigations addressing the regional hydroclimate nexus.</p>
            </div>
            <div>
                <a asp-controller="Research" asp-action="Index" class="btn btn-hsrl-outline">
                    View All Domains <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var domain in Model.ResearchDomains)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="hsrl-card">
                        <div class="hsrl-card-body">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="hsrl-brand-icon" style="background: rgba(14, 165, 233, 0.1); color: var(--hsrl-hydro-dark);">
                                    <i class="bi @domain.IconName fs-4"></i>
                                </div>
                                <span class="badge bg-light text-muted border font-monospace">Domain 0@(domain.DisplayOrder)</span>
                            </div>
                            <h5 class="fw-bold mb-2 text-navy">@domain.Title</h5>
                            <p class="text-muted small mb-3">@domain.ShortDescription</p>
                            
                            @if (domain.FocusTopics.Any())
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <span class="d-block text-uppercase small text-muted fw-bold mb-2 font-monospace" style="font-size: 0.7rem;">Key Focus Topics</span>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var topic in domain.FocusTopics.Take(2))
                                        {
                                            <span class="hsrl-badge hsrl-badge-hydro">@topic.Topic</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="hsrl-card-footer d-flex justify-content-between align-items-center">
                            <a asp-controller="Research" asp-action="Index" class="text-decoration-none fw-semibold small text-primary">
                                Read Domain Details <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Geographic Scope Section -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-eyebrow"><i class="bi bi-compass-fill"></i> Territorial Coverage</span>
                <h2 class="section-title">Geographic & Environmental Scope</h2>
                <p class="section-lead">
                    HSRL's geographical domain spans the entire hydrological continuum of the Indus River Basin — from the high-altitude glacier-fed headwaters in the Karakoram to the deltaic coastal wetlands in the Arabian Sea.
                </p>
                <div class="vstack gap-3 mt-4">
                    <div class="d-flex gap-3">
                        <i class="bi bi-snow2 fs-3 text-info"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Upper Indus Basin & High Mountain Cryosphere</h6>
                            <p class="text-muted small mb-0">Gilgit-Baltistan, Hunza, and pass reaches — monitoring glacier mass anomalies, glacial lakes, and snowpack accumulation.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <i class="bi bi-water fs-3 text-primary"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Indus River Mainstem & Tributaries</h6>
                            <p class="text-muted small mb-0">Jhelum, Chenab, Ravi, and Sutlej floodplains — calibrating 2D hydrodynamic flood propagation and levee breach models.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <i class="bi bi-layers fs-3 text-success"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Indus Basin Irrigation System (IBIS)</h6>
                            <p class="text-muted small mb-0">Intensively farmed doabs across Punjab and Sindh — tracking multi-decadal aquifer depletion via GRACE gravimetry.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="p-4 rounded-4 text-white" style="background: linear-gradient(135deg, var(--hsrl-navy-dark), var(--hsrl-navy)); border: 1px solid rgba(14, 165, 233, 0.3);">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-info"></i> Regional Transboundary Basins
                    </h5>
                    <p class="small text-white-50 mb-4">
                        Because water flows without political boundaries, our satellite sensing algorithms ingest planetary datasets covering transboundary basins in South Asia and the Hindu Kush Himalaya (HKH) region.
                    </p>
                    <div class="row g-3 text-center">
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10">
                                <span class="font-monospace fs-4 fw-bold text-info">1.12M</span>
                                <div class="small text-white-50">km² Basin Extent</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10">
                                <span class="font-monospace fs-4 fw-bold text-info">>5,000</span>
                                <div class="small text-white-50">Glaciers Monitored</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lab Capabilities Section -->
<section class="py-5" style="background-color: var(--hsrl-surface-bg);">
    <div class="container py-4">
        <div class="section-header text-center">
            <span class="section-eyebrow"><i class="bi bi-tools"></i> Infrastructure & Tooling</span>
            <h2 class="section-title">Technical Capabilities</h2>
            <p class="section-lead">World-class computational and analytical infrastructure dedicated to hydroclimatic research.</p>
        </div>

        <div class="row g-4">
            @foreach (var cap in Model.Capabilities)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="hsrl-card">
                        <div class="hsrl-card-body">
                            <div class="hsrl-brand-icon mb-3" style="background: rgba(10, 37, 64, 0.08); color: var(--hsrl-navy);">
                                <i class="bi @cap.IconName fs-4"></i>
                            </div>
                            <span class="badge bg-secondary-subtle text-secondary small font-monospace mb-2">@cap.Category</span>
                            <h6 class="fw-bold text-navy mb-2">@cap.Title</h6>
                            <p class="text-muted small mb-3">@cap.Description</p>
                            
                            @if (cap.Highlights.Any())
                            {
                                <ul class="list-unstyled small text-muted mb-0 pt-2 border-top">
                                    @foreach (var item in cap.Highlights.Take(2))
                                    {
                                        <li class="mb-1 d-flex gap-2">
                                            <i class="bi bi-check2 text-success"></i>
                                            <span>@item.Highlight</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Final Collaboration CTA Banner -->
<section class="py-5 text-white" style="background: linear-gradient(135deg, var(--hsrl-navy-dark) 0%, var(--hsrl-navy) 100%);">
    <div class="container py-4 text-center">
        <div class="max-w-750 mx-auto">
            <span class="hsrl-hero-tag mb-3">
                <i class="bi bi-handshake text-info"></i> Partner With Us
            </span>
            <h2 class="display-5 fw-bold mb-3">Collaborate With HSRL</h2>
            <p class="lead text-white-50 mb-4">
                We invite academic researchers, government departments, international development agencies, and graduate applicants to partner with us on cutting-edge water and climate initiatives.
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-3">
                <a asp-controller="Collaboration" asp-action="Index" class="btn btn-hsrl-hydro btn-lg">
                    <i class="bi bi-pencil-square me-2"></i> Submit Collaboration Proposal
                </a>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-mortarboard me-2"></i> View Open Opportunities
                </a>
            </div>
        </div>
    </div>
</section>
