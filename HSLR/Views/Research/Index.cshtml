@model List<HSLR.Models.Entities.ResearchDomain>
@{
    ViewData["Title"] = "Research Domains & Scientific Pipeline";
    var capabilities = ViewBag.Capabilities as List<HSLR.Models.Entities.Capability> ?? new();
}

<!-- Page Header -->
<div class="hsrl-page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Research</li>
            </ol>
        </nav>
        <h1>Research Pipeline & Core Domains</h1>
        <p>
            Bridging spaceborne earth observation constellations, numerical physics, and scientific machine learning to address regional hydroclimatic extremes and water security.
        </p>
    </div>
</div>

<div class="container pb-5">
    <!-- Scientific Pipeline Section -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-5" style="background: linear-gradient(135deg, #07192d 0%, #0a2540 100%); color: #ffffff;">
        <div class="row align-items-center mb-4">
            <div class="col-lg-8">
                <span class="hsrl-hero-tag mb-2"><i class="bi bi-diagram-3-fill text-info"></i> End-to-End Methodology</span>
                <h2 class="h3 fw-bold text-white mb-2">The HSRL Integrated Research Pipeline</h2>
                <p class="text-white-50 mb-0">
                    How HSRL transforms planetary satellite constellations into actionable insights for engineers, hydrologists, and policymakers.
                </p>
            </div>
        </div>

        <div class="row g-4 text-start">
            <div class="col-md-6 col-lg-3">
                <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-info text-dark font-monospace">STAGE 1</span>
                        <h6 class="fw-bold mb-0 text-white">Spaceborne Sensing</h6>
                    </div>
                    <p class="small text-white-50 mb-2">
                        Ingestion of SAR (Sentinel-1), radar altimetry (SWOT), optical imagery (Sentinel-2, Landsat), and satellite gravity (GRACE/GRACE-FO).
                    </p>
                    <span class="small font-monospace text-info"><i class="bi bi-check2"></i> Multi-sensor fusion</span>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-info text-dark font-monospace">STAGE 2</span>
                        <h6 class="fw-bold mb-0 text-white">Numerical Modeling</h6>
                    </div>
                    <p class="small text-white-50 mb-2">
                        Catchment water balance and 2D unsteady hydrodynamic routing via HEC-RAS, WRF-Hydro, and regional MODFLOW aquifer representations.
                    </p>
                    <span class="small font-monospace text-info"><i class="bi bi-check2"></i> Physics conservation</span>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-info text-dark font-monospace">STAGE 3</span>
                        <h6 class="fw-bold mb-0 text-white">Physics-Informed AI</h6>
                    </div>
                    <p class="small text-white-50 mb-2">
                        Deep recurrent networks (LSTMs), vision transformers, and PINNs constrained by mass conservation for high-accuracy forecasts.
                    </p>
                    <span class="small font-monospace text-info"><i class="bi bi-check2"></i> Machine learning speed</span>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-info text-dark font-monospace">STAGE 4</span>
                        <h6 class="fw-bold mb-0 text-white">Decision Systems</h6>
                    </div>
                    <p class="small text-white-50 mb-2">
                        Operational early warning bulletins, interactive risk maps, and policy briefings delivered to PCRWR, WAPDA, and NDMA.
                    </p>
                    <span class="small font-monospace text-info"><i class="bi bi-check2"></i> Real-world impact</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Domains Breakdown -->
    <div class="section-header text-center mb-5">
        <span class="section-eyebrow"><i class="bi bi-compass"></i> Scientific Investigations</span>
        <h2 class="section-title">Research Domains</h2>
        <p class="section-lead">Explore our primary thematic lines of inquiry, focus topics, and active project affiliations.</p>
    </div>

    <div class="vstack gap-5">
        @foreach (var domain in Model)
        {
            <div id="@domain.Slug" class="card border rounded-4 shadow-sm overflow-hidden">
                <div class="card-header bg-white p-4 border-bottom">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="hsrl-brand-icon" style="background: rgba(14, 165, 233, 0.1); color: var(--hsrl-hydro-dark);">
                                <i class="bi @domain.IconName fs-4"></i>
                            </div>
                            <div>
                                <span class="badge bg-light text-muted border font-monospace mb-1">Domain 0@(domain.DisplayOrder)</span>
                                <h3 class="h4 fw-bold mb-0 text-navy">@domain.Title</h3>
                            </div>
                        </div>
                        <a asp-controller="Collaboration" asp-action="Index" class="btn btn-sm btn-hsrl-outline">
                            <i class="bi bi-send me-1"></i> Propose Research in This Domain
                        </a>
                    </div>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <h5 class="fw-bold text-navy mb-3">Overview & Scientific Scope</h5>
                            <p class="text-secondary mb-4" style="line-height: 1.8;">
                                @domain.Description
                            </p>

                            <h6 class="fw-bold text-navy mb-3 font-monospace text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                                Core Scientific Focus Topics:
                            </h6>
                            <div class="row g-2">
                                @foreach (var topic in domain.FocusTopics)
                                {
                                    <div class="col-md-6">
                                        <div class="p-2 rounded-3 bg-light border small text-dark d-flex gap-2 align-items-center">
                                            <i class="bi bi-check-circle-fill text-info flex-shrink-0"></i>
                                            <span>@topic.Topic</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="bg-light p-4 rounded-4 border h-100">
                                <h6 class="fw-bold text-navy mb-3 font-monospace text-uppercase" style="font-size: 0.8rem;">
                                    <i class="bi bi-briefcase-fill me-1 text-primary"></i> Linked Research Projects
                                </h6>
                                @if (domain.ProjectResearchAreas.Any())
                                {
                                    <div class="vstack gap-2 mb-4">
                                        @foreach (var pra in domain.ProjectResearchAreas.Take(3))
                                        {
                                            <div class="p-2 bg-white rounded-2 border">
                                                <a asp-controller="Projects" asp-action="Details" asp-route-slug="@pra.Project?.Slug" class="text-decoration-none fw-semibold small text-navy">
                                                    @pra.Project?.Title
                                                </a>
                                                <div class="d-flex justify-content-between align-items-center mt-1">
                                                    <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.65rem;">@pra.Project?.Status</span>
                                                    <span class="small text-muted font-monospace" style="font-size: 0.75rem;">@pra.Project?.Year</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="small text-muted mb-4">Ongoing studies under review.</p>
                                }

                                <h6 class="fw-bold text-navy mb-3 font-monospace text-uppercase" style="font-size: 0.8rem;">
                                    <i class="bi bi-journal-text me-1 text-primary"></i> Representative Publications
                                </h6>
                                @if (domain.PublicationResearchAreas.Any())
                                {
                                    <div class="vstack gap-2">
                                        @foreach (var pra in domain.PublicationResearchAreas.Take(2))
                                        {
                                            <div class="p-2 bg-white rounded-2 border">
                                                <div class="fw-semibold small text-navy mb-1">
                                                    @(pra.Publication?.Title.Length > 90 ? pra.Publication?.Title.Substring(0, 90) + "..." : pra.Publication?.Title)
                                                </div>
                                                <span class="badge bg-secondary-subtle text-secondary font-monospace" style="font-size: 0.65rem;">@pra.Publication?.Journal (@pra.Publication?.Year)</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="small text-muted mb-0">Manuscripts in preparation.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Capabilities Section -->
    <div class="mt-5 pt-4">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow"><i class="bi bi-cpu"></i> Infrastructure</span>
            <h2 class="section-title">Computing & Laboratory Capabilities</h2>
            <p class="section-lead">The computational clusters and instrumentation supporting our research domains.</p>
        </div>

        <div class="row g-4">
            @foreach (var cap in capabilities)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="hsrl-card">
                        <div class="hsrl-card-body">
                            <div class="hsrl-brand-icon mb-3" style="background: rgba(10, 37, 64, 0.08); color: var(--hsrl-navy);">
                                <i class="bi @cap.IconName fs-4"></i>
                            </div>
                            <span class="badge bg-secondary-subtle text-secondary small font-monospace mb-2">@cap.Category</span>
                            <h6 class="fw-bold text-navy mb-2">@cap.Title</h6>
                            <p class="text-muted small mb-3">@cap.Description</p>

                            @if (cap.Highlights.Any())
                            {
                                <ul class="list-unstyled small text-muted mb-0 pt-2 border-top">
                                    @foreach (var item in cap.Highlights)
                                    {
                                        <li class="mb-1 d-flex gap-2">
                                            <i class="bi bi-check-lg text-success"></i>
                                            <span>@item.Highlight</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
